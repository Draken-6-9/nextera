# ══════════════════════════════════════════════
# NextEra — Variables d'environnement
# ══════════════════════════════════════════════

# Serveur
PORT=3000
NODE_ENV=production
JWT_SECRET=CHANGEZ_MOI_avec_une_longue_chaine_aleatoire_32chars

# PostgreSQL (fourni automatiquement par Render)
DATABASE_URL=postgresql://user:password@host:5432/nextera_db

# ── MTN MoMo (remplir après inscription sur momodeveloper.mtn.com) ──
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_PRIMARY_KEY=VOTRE_PRIMARY_KEY
MTN_API_USER=VOTRE_API_USER_UUID
MTN_API_KEY=VOTRE_API_KEY
MTN_TARGET_ENV=sandbox
MTN_CURRENCY=XAF

# ── Orange Money (remplir après inscription sur developer.orange.com) ──
ORANGE_BASE_URL=https://api.orange.com/orange-money-webpay/cm/v1
ORANGE_CLIENT_ID=VOTRE_CLIENT_ID
ORANGE_CLIENT_SECRET=VOTRE_CLIENT_SECRET
ORANGE_MERCHANT_KEY=VOTRE_MERCHANT_KEY
